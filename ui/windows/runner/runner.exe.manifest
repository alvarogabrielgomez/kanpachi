<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
  <!-- asInvoker no estaba, y su ausencia es un riesgo real y no un descuido de
       estilo. KB5089549 y KB5087051 cambiaron Windows para INFERIR si un
       ejecutable sin requestedExecutionLevel necesita elevacion, y esa
       inferencia ya alcanza a los binarios de 64 bits: medido el 2026-08-10
       sobre kanpachi-engine.exe, que pedia UAC a su nombre sin que nadie lo
       elevara. Esta ventana tiene que correr SIN privilegios por diseno, asi
       que una elevacion adivinada por Windows romperia lo que el daemon se
       toma el trabajo de garantizar en spawn_windows.go. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
